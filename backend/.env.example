# VigilOps AI - Matrix Telemetry Gateway Configuration
# Copy this file to .env and configure with your credentials.

PORT=5000
NODE_ENV=development
FASTAPI_URL=http://localhost:8000
DASHBOARD_URL=http://localhost:5173

# ==============================================================================
# GMAIL SMTP NOTIFICATION CONFIGURATION (Exclusive Email Dispatch)
# ==============================================================================
# 1. Enable 2-Step Verification in your Google Account: https://myaccount.google.com/security
# 2. Generate an "App Password": https://myaccount.google.com/apppasswords
# 3. Enter your Gmail and 16-character App Password below:
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_gmail_address@gmail.com
SMTP_PASS=your_google_app_password
EMAIL_FROM=your_gmail_address@gmail.com
EMAIL_ENABLED=true

# ==============================================================================
# SMS DISPATCH (DISABLED - VigilOps AI runs in Gmail-Only Notification Mode)
# ==============================================================================
SMS_ENABLED=false

# ==============================================================================
# ALERT & INCIDENT POLICY
# ==============================================================================
# Minimum cooldown period in seconds between repeated alerts for the same hazard/zone
ALERT_COOLDOWN_SECONDS=60

# Critical risk score threshold (0.0 to 1.0) to trigger automated emergency dispatch
CRITICAL_THRESHOLD=0.75

# Secret key required for sensitive operations
ADMIN_API_KEY=vigilops-admin-secret-2026
